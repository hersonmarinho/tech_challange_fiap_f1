  "item": [
    {
      "name": "Cadastro",
      "item": [
        {
          "name": "Cadastro válido - Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response tem ID, nome, login e email', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('nome');",
                  "    pm.expect(jsonData).to.have.property('login');",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "    pm.environment.set('usuario_id_cliente', jsonData.id);",
                  "    pm.environment.set('usuario_login', jsonData.login);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"login\": \"joao_silva_001\",\n  \"senha\": \"SenhaSegura@123\",\n  \"email\": \"joao.silva@horadoprato.com\",\n  \"tipoUsuario\": \"CLIENTE\",\n  \"endereco\": {\n    \"logradouro\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"complemento\": \"Apto 42\",\n    \"bairro\": \"Centro\",\n    \"cidade\": \"São Paulo\",\n    \"estado\": \"SP\",\n    \"cep\": \"01310-100\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/usuarios/cadastrar",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "usuarios", "cadastrar"]
            }
          }
        },
