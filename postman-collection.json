    {
      "name": "Busca",
      "item": [
        {
          "name": "Buscar usuários por nome",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response é um array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Cada resultado tem id, nome, login e email', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('id');",
                  "        pm.expect(jsonData[0]).to.have.property('nome');",
                  "        pm.expect(jsonData[0]).to.have.property('login');",
                  "        pm.expect(jsonData[0]).to.have.property('email');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/usuarios/buscar?nome=João",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "usuarios", "buscar"],
              "query": [
                {
                  "key": "nome",
